# Environment
NODE_ENV=development

# Server
PORT=3000

# MongoDB
# For local development: mongodb://localhost:27017/shareplate
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/shareplate?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/shareplate

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# Rate Limiting
# Keep enabled in normal environments, but increase/disable for performance tests
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Email Service (Third-party API Integration) - REQUIRED for password reset
# Option 1: SendGrid (Recommended for production)
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@shareplate.com
FROM_NAME=SharePlate Platform

# Option 2: Gmail (For development/testing)
# Get app password from: https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-gmail-app-password

# Frontend URL (for email verification and password reset links)
FRONTEND_URL=http://localhost:3001

# CORS — comma-separated list of allowed origins
# In production set this to your actual frontend URL, e.g.:
# ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SMS Service (Optional - for future use)
SMS_API_KEY=your-sms-api-key
SMS_ACCOUNT_SID=your-sms-account-sid
